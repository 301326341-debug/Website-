  </div>

  <script>
    /* ========================================================
       1. CANVAS MATRIX & PARTICLE TEXT ANIMATION SEQUENCE
    ======================================================== */
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // Matrix Rain Code
    const chars = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ♥I LOVE YOU MASHA';
    const fontSize = 14;
    let columns = Math.floor(canvas.width / fontSize);
    let drops = Array(columns).fill(1);

    function drawMatrix() {
      ctx.fillStyle = 'rgba(3, 2, 6, 0.12)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = '#ff2a8d';
      ctx.font = fontSize + 'px monospace';

      for (let i = 0; i < drops.length; i++) {
        const text = chars.charAt(Math.floor(Math.random() * chars.length));
        ctx.fillText(text, i * fontSize, drops[i] * fontSize);

        if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
          drops[i] = 0;
        }
        drops[i]++;
      }
    }

    // Canvas Particle Text Phrases
    const phrases = [
      "3",
      "2",
      "1",
      "You",
      "Are",
      "My",
      "Love",
      "I Love U So Much",
      "Meri Janu",
      "Mera Chota Sa Baby",
      "Meri Masha",
      "Meri Wife ❤️"
    ];

    let phraseIndex = 0;
    let particles = [];
    let animationStage = 0; // 0: phrases sequence, 1: particle heart formed

    class Particle {
      constructor(x, y) {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.targetX = x;
        this.targetY = y;
        this.color = '#ffffff';
        this.size = Math.random() * 2 + 1.5;
        this.ease = 0.08;
      }

      update() {
        this.x += (this.targetX - this.x) * this.ease;
        this.y += (this.targetY - this.y) * this.ease;
      }

      draw() {
        ctx.fillStyle = this.color;
        ctx.shadowBlur = 10;
        ctx.shadowColor = '#ff69b4';
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
      }
    }

    function getTextCoordinates(text) {
      const offscreen = document.createElement('canvas');
      const offCtx = offscreen.getContext('2d');
      offscreen.width = canvas.width;
      offscreen.height = canvas.height;

      let size = Math.min(canvas.width / (text.length * 0.7), 65);
      if (text.length <= 2) size = 110;

      offCtx.fillStyle = '#ffffff';
      offCtx.font = `bold ${size}px 'Segoe UI', sans-serif`;
      offCtx.textAlign = 'center';
      offCtx.textBaseline = 'middle';
      offCtx.fillText(text, canvas.width / 2, canvas.height / 2);

      const imageData = offCtx.getImageData(0, 0, canvas.width, canvas.height);
      const coords = [];
      const step = Math.max(2, Math.floor(size / 24));

      for (let y = 0; y < canvas.height; y += step) {
        for (let x = 0; x < canvas.width; x += step) {
          const alpha = imageData.data[(y * canvas.width + x) * 4 + 3];
          if (alpha > 128) {
            coords.push({ x, y });
          }
        }
      }
      return coords;
    }

    function createHeartParticles() {
      const coords = [];
      const total = 380;
      const scale = Math.min(canvas.width, canvas.height) / 45;

      for (let i = 0; i < total; i++) {
        const t = (i / total) * Math.PI * 2;
        const x = 16 * Math.pow(Math.sin(t), 3);
        const y = -(13 * Math.cos(t) - 5 * Math.cos(2*t) - 2 * Math.cos(3*t) - Math.cos(4*t));
        coords.push({
          x: canvas.width / 2 + x * scale,
          y: canvas.height / 2 + y * scale
        });
      }
      return coords;
    }

    function loadNextPhrase() {
      if (phraseIndex < phrases.length) {
        const coords = getTextCoordinates(phrases[phraseIndex]);
        adjustParticles(coords);
        phraseIndex++;
        setTimeout(loadNextPhrase, 2200);
      } else {
        // Form Floating Heart Particle Shape
        animationStage = 1;
        const heartCoords = createHeartParticles();
        adjustParticles(heartCoords);

        document.getElementById('matrixStatus').innerText = "💖 Matrix Heart Formed! Open your birthday letter below 💌";
      }
    }

    function adjustParticles(coords) {
      if (particles.length < coords.length) {
        while (particles.length < coords.length) {
          particles.push(new Particle(canvas.width / 2, canvas.height / 2));
        }
      } else if (particles.length > coords.length) {
        particles.splice(coords.length);
      }

      for (let i = 0; i < coords.length; i++) {
        particles[i].targetX = coords[i].x;
        particles[i].targetY = coords[i].y;
      }
    }

    function animateCanvas() {
      drawMatrix();

      particles.forEach(p => {
        p.update();
        p.draw();
      });

      if (animationStage === 1) {
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 22px "Segoe UI", sans-serif';
        ctx.textAlign = 'center';
        ctx.shadowBlur = 12;
        ctx.shadowColor = '#ff1493';
        ctx.fillText("I Love You Masha ❤️", canvas.width / 2, canvas.height / 2);
        ctx.shadowBlur = 0;
      }

      requestAnimationFrame(animateCanvas);
    }

    // Start Canvas Animation
    animateCanvas();
    setTimeout(loadNextPhrase, 1000);


    /* ========================================================
       2. COCOMALLOW INTERACTIVE CARD LOGIC
    ======================================================== */

    // Background Flying Elements
    function createBgItem() {
      const container = document.getElementById('bgContainer');
      const item = document.createElement('div');
      item.classList.add('bg-item');
      
      const icons = ['💖', '🍡', '💕', '✨', '🌸', '🍬', '💗', '💋'];
      item.innerText = icons[Math.floor(Math.random() * icons.length)];
      
      item.style.left = Math.random() * 100 + 'vw';
      item.style.animationDuration = (Math.random() * 3 + 4) + 's';
      item.style.fontSize = (Math.random() * 1.2 + 1) + 'rem';
      
      container.appendChild(item);
      setTimeout(() => { item.remove(); }, 7000);
    }
    setInterval(createBgItem, 350);

    // Music Player Control
    const music = document.getElementById('bgMusic');
    const playBtn = document.getElementById('playBtn');
    const songStatus = document.getElementById('songStatus');

    function toggleMusic() {
      if (music.paused) {
        music.play();
        playBtn.innerText = '⏸';
        songStatus.innerText = 'Playing Sweet Love Song 🎶';
      } else {
        music.pause();
        playBtn.innerText = '▶';
        songStatus.innerText = 'Music Paused 🎵';
      }
    }

    // Open Letter -> Reveals Quiz
    function openLetter() {
      document.getElementById('envelopeBox').style.display = 'none';
      document.getElementById('letterBox').style.display = 'block';
      document.getElementById('quizSection').style.display = 'block';
      
      if (music.paused) { toggleMusic(); }
      burstHearts(15);
    }

    // Quiz Selection Handler
    function selectQuizAnswer(answerText) {
      const resultDiv = document.getElementById('quizResult');
      resultDiv.style.display = 'block';
      resultDiv.innerText = `Aww! ${answerText} Leak ho gaya aapka sach! Main bhi aapse sabse zyada pyar karta hu! 🥰💖`;
      
      document.getElementById('kissSection').style.display = 'block';
      document.getElementById('kissSection').scrollIntoView({ behavior: 'smooth' });
      
      burstHearts(20);
    }

    // Flying Kiss Animation & Counter
    let kissCount = 0;
    function triggerKissAnimation(event) {
      kissCount++;
      document.getElementById('kissCounter').innerText = `Kisses Sent: ${kissCount} 😘 (Pure Love!)`;

      const kissIcons = ['💋', '😘', '😚', '💖', '🥰'];
      for (let i = 0; i < 5; i++) {
        const flyingKiss = document.createElement('div');
        flyingKiss.classList.add('flying-kiss');
        flyingKiss.innerText = kissIcons[Math.floor(Math.random() * kissIcons.length)];
        
        const x = event.clientX + (Math.random() * 80 - 40);
        const y = event.clientY + (Math.random() * 40 - 20);
        
        flyingKiss.style.left = `${x}px`;
        flyingKiss.style.top = `${y}px`;
        
        document.body.appendChild(flyingKiss);
        setTimeout(() => { flyingKiss.remove(); }, 1500);
      }

      // Show Question Declaration Section
      const loveDecl = document.getElementById('loveDeclaration');
      if (loveDecl.style.display !== 'block') {
        loveDecl.style.display = 'block';
        loveDecl.scrollIntoView({ behavior: 'smooth' });
        burstHearts(25);
      }
    }

    // Reply Action ("I love u too so much janu!")
    function submitILoveYouToo() {
      const replyBtn = document.getElementById('replyBtn');
      replyBtn.style.display = 'none';

      const confirmedMsg = document.getElementById('replyConfirmedMsg');
      confirmedMsg.style.display = 'block';

      burstHearts(30);

      // Show Cocomallow Hug section after 1 second
      setTimeout(() => {
        const hugSec = document.getElementById('hugSection');
        hugSec.style.display = 'block';
        hugSec.scrollIntoView({ behavior: 'smooth' });
        burstHearts(20);
      }, 1000);
    }

    // Heart Burst Helper
    function burstHearts(count) {
      for (let i = 0; i < count; i++) {
        setTimeout(() => { createBgItem(); }, i * 50);
      }
    }
  </script>
</body>
