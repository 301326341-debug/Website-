    </div>
    <audio id="bgMusic" loop src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=romantic-love-112261.mp3"></audio>

    <!-- Canvas Animation Sequence Status -->
    <div class="matrix-status" id="matrixStatus">✨ Matrix particles animating in background... ✨</div>

    <!-- STEP 1: ENVELOPE -->
    <div class="envelope-box" id="envelopeBox" onclick="openLetter()">
