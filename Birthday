    <!-- STEP 3: INTERACTIVE LOVE QUIZ -->
    <div class="quiz-section" id="quizSection">
      <div class="quiz-title">❓ Quick Love Question for You! 💖</div>
      <p style="margin-bottom: 15px; font-size: 0.95rem;">Sachi batao, aap mujhse kitna pyar karti ho?</p>
