  <!-- Interactive Card Container -->
  <div class="card-container">
    <h1 class="main-title">💕 Cocomallow Marshmallow</h1>
    <p class="subtitle">Happy Birthday to My Cutie Wife Masha!</p>

    <!-- Music Player -->
