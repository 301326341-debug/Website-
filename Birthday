<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>For My Wife Masha ❤️ | Cocomallow Birthday Surprise</title>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Dancing+Script:wght@700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body, html {
      width: 100%;
      min-height: 100vh;
      background-color: #030206;
      font-family: 'Poppins', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      overflow-x: hidden;
      position: relative;
    }

    /* Background Matrix Canvas */
    canvas {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
    }

    /* Floating Items in Background */
    .bg-item {
      position: fixed;
      top: -10vh;
      font-size: 1.5rem;
      user-select: none;
      pointer-events: none;
      animation: floatDown linear infinite;
      z-index: 2;
    }

    @keyframes floatDown {
      0% { transform: translateY(0) rotate(0deg) scale(0.8); opacity: 0.9; }
      100% { transform: translateY(110vh) rotate(360deg) scale(1.2); opacity: 0.1; }
    }

    /* Main Glassmorphic Card Container */
    .card-container {
      position: relative;
      z-index: 10;
      max-width: 650px;
      width: 100%;
      background: rgba(12, 6, 18, 0.82);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 28px;
      border: 1px solid rgba(255, 105, 180, 0.35);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 35px rgba(255, 20, 147, 0.25);
      padding: 35px 25px;
      text-align: center;
      color: #f0e6ed;
      margin: 20px auto;
    }

    .main-title {
      font-family: 'Fredoka One', cursive;
      font-size: 2.3rem;
      color: #ff4d7d;
      text-shadow: 0 0 15px rgba(255, 77, 125, 0.6), 2px 3px 0px #000;
      margin-bottom: 5px;
    }

    .subtitle {
      font-size: 0.95rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #ffa6c1;
      margin-bottom: 20px;
      font-weight: 600;
    }

    /* Music Player */
    .music-player {
      background: rgba(255, 255, 255, 0.08);
      border-radius: 50px;
      padding: 8px 18px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 25px;
      border: 1px solid rgba(255, 105, 180, 0.25);
    }

    .play-btn {
      background: #ff4b6e;
      color: white;
      border: none;
      border-radius: 50%;
      width: 38px;
      height: 38px;
      font-size: 1.1rem;
      cursor: pointer;
      transition: transform 0.2s;
    }

    .play-btn:hover { transform: scale(1.1); }

    .song-title {
      font-size: 0.85rem;
      font-weight: 600;
      color: #f3d0db;
    }

    /* Status Indicator for Matrix Particle Animation */
    .matrix-status {
      font-size: 0.85rem;
      color: #ff8da1;
      margin-bottom: 15px;
      font-style: italic;
    }

    /* STEP 1: ENVELOPE BOX */
    .envelope-box {
      background: linear-gradient(135deg, #7a1b3c, #ff4b6e);
      border-radius: 20px;
      padding: 40px 20px;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 75, 110, 0.4);
      transition: all 0.4s ease;
    }

    .envelope-box:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 15px 35px rgba(255, 20, 147, 0.6);
    }

    .envelope-icon {
      font-size: 4rem;
      animation: pulse 1.5s infinite;
    }

    .click-hint {
      font-family: 'Fredoka One', cursive;
      font-size: 1.2rem;
      color: white;
      margin-top: 10px;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.15); }
    }

    /* STEP 2: LETTER CONTAINER */
    .letter-container {
      display: none;
      text-align: left;
      background: rgba(18, 10, 24, 0.9);
      padding: 28px;
      border-radius: 20px;
      line-height: 1.8;
      font-size: 0.95rem;
      color: #ffe6f2;
      border-left: 5px solid #ff4b6e;
      border-right: 1px solid rgba(255, 105, 180, 0.3);
      max-height: 350px;
      overflow-y: auto;
      margin-bottom: 25px;
      animation: slideUp 0.6s ease forwards;
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .highlight {
      color: #ff8da1;
      font-weight: 600;
    }

    .signature {
      font-family: 'Dancing Script', cursive;
      font-size: 1.9rem;
      color: #ff7597;
      text-align: right;
      margin-top: 20px;
      display: block;
    }

    /* STEP 3: LOVE QUIZ SECTION */
    .quiz-section {
      display: none;
      background: rgba(255, 75, 110, 0.1);
      border: 1px dashed #ff4d7d;
      border-radius: 20px;
      padding: 20px;
      margin-bottom: 25px;
      animation: fadeIn 0.8s ease forwards;
    }

    .quiz-title {
      font-family: 'Fredoka One', cursive;
      color: #ffa6c1;
      font-size: 1.2rem;
      margin-bottom: 12px;
    }

    .quiz-options {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .quiz-btn {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid #ff4d7d;
      color: #fff;
      padding: 11px 15px;
      border-radius: 12px;
      cursor: pointer;
      font-family: 'Poppins', sans-serif;
      font-size: 0.9rem;
      transition: all 0.3s ease;
    }

    .quiz-btn:hover {
      background: #ff4b6e;
      transform: scale(1.02);
    }

    .quiz-result {
      display: none;
      margin-top: 15px;
      font-family: 'Fredoka One', cursive;
      color: #ff758c;
      font-size: 1.1rem;
      animation: pulse 1s infinite;
    }

    /* STEP 4: KISS ANIMATION SECTION */
    .kiss-section {
      display: none;
      margin-bottom: 25px;
      animation: fadeIn 0.8s ease forwards;
    }

    .kiss-btn {
      background: linear-gradient(45deg, #ff1493, #ff69b4);
      color: white;
      border: none;
      padding: 14px 28px;
      font-size: 1.1rem;
      font-family: 'Fredoka One', cursive;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 8px 25px rgba(255, 20, 147, 0.5);
      transition: all 0.2s ease;
    }

    .kiss-btn:active { transform: scale(0.95); }

    .kiss-counter {
      margin-top: 10px;
      font-size: 0.9rem;
      color: #ffa6c1;
      font-weight: 600;
    }

    .flying-kiss {
      position: fixed;
      font-size: 2.5rem;
      pointer-events: none;
      z-index: 100;
      animation: flyUp 1.5s ease-out forwards;
    }

    @keyframes flyUp {
      0% { transform: translateY(0) scale(0.5) rotate(0deg); opacity: 1; }
      100% { transform: translateY(-200px) scale(1.8) rotate(20deg); opacity: 0; }
    }

    /* STEP 5: QUESTION & REPLY ANIMATION SECTION */
    .love-declaration {
      display: none;
      margin-bottom: 25px;
      padding: 30px 20px;
      background: rgba(255, 20, 147, 0.12);
      border: 2px solid #ff1493;
      border-radius: 24px;
      box-shadow: 0 0 30px rgba(255, 20, 147, 0.4);
      animation: pulseGlow 2s infinite alternate, fadeIn 0.8s ease forwards;
    }

    @keyframes pulseGlow {
      0% { box-shadow: 0 0 15px rgba(255, 20, 147, 0.3); border-color: #ff4b6e; }
      100% { box-shadow: 0 0 35px rgba(255, 105, 180, 0.8); border-color: #ff1493; }
    }

    .big-beating-heart {
      font-size: 4.5rem;
      display: inline-block;
      animation: heartBeat 1.2s infinite;
    }

    @keyframes heartBeat {
      0%, 100% { transform: scale(1); }
      15% { transform: scale(1.25); }
      30% { transform: scale(1); }
      45% { transform: scale(1.15); }
    }

    .ily-title {
      font-family: 'Fredoka One', cursive;
      font-size: clamp(1.3rem, 4.5vw, 1.7rem);
      color: #ff69b4;
      text-shadow: 0 0 12px rgba(255, 105, 180, 0.8), 2px 2px 4px #000;
      margin: 12px 0 5px 0;
      line-height: 1.3;
    }

    .ily-question {
      font-size: 1rem;
      color: #ffd1dc;
      font-weight: 600;
      margin: 10px 0 18px 0;
    }

    .reply-action-btn {
      background: linear-gradient(45deg, #ff1493, #ff758c);
      color: white;
      border: none;
      padding: 14px 24px;
      font-size: 1.05rem;
      font-family: 'Fredoka One', cursive;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(255, 20, 147, 0.5);
      transition: all 0.3s;
      animation: bounce 2s infinite;
    }

    .reply-action-btn:hover {
      transform: scale(1.06);
      box-shadow: 0 10px 25px rgba(255, 20, 147, 0.7);
    }

    .reply-confirmed-msg {
      display: none;
      margin-top: 15px;
      font-family: 'Fredoka One', cursive;
      font-size: 1.2rem;
      color: #ff85a2;
      animation: pulse 1s infinite;
    }

    @keyframes bounce {
      0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
      40% { transform: translateY(-8px); }
      60% { transform: translateY(-4px); }
    }

    /* STEP 6: HUG SECTION */
    .hug-section {
      display: none;
      margin-top: 25px;
      padding: 20px;
      background: rgba(25, 15, 24, 0.85);
      border-radius: 20px;
      border: 2px dashed #ff4d7d;
      animation: fadeIn 0.8s ease forwards;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }

    .hug-title {
      font-family: 'Fredoka One', cursive;
      color: #ff4d7d;
      font-size: 1.4rem;
      margin-bottom: 15px;
    }

    .marshmallow-stage {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 140px;
      position: relative;
    }

    .mallow {
      width: 70px;
      height: 85px;
      background: #ffffff;
      border-radius: 25px 25px 20px 20px;
      box-shadow: inset -4px -4px 10px rgba(0,0,0,0.15), 0 8px 20px rgba(0, 0, 0, 0.4);
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border: 3px solid #ffd1dc;
    }

    .mallow.left {
      background: #fff0f5;
      left: 32%;
      animation: hugLeft 2s ease-in-out infinite alternate;
    }

    .mallow.right {
      background: #ffffff;
      right: 32%;
      animation: hugRight 2s ease-in-out infinite alternate;
    }

    .eyes { display: flex; gap: 12px; margin-top: -10px; }
    .eye { width: 7px; height: 9px; background: #331520; border-radius: 50%; }
    .blush { width: 10px; height: 5px; background: #ff85a2; border-radius: 50%; margin-top: 3px; }
    .blushes { display: flex; gap: 18px; }

    .arm {
      width: 25px;
      height: 8px;
      background: #ffd1dc;
      border-radius: 10px;
      position: absolute;
      top: 45px;
    }
    .left .arm { right: -12px; transform: rotate(-20deg); }
    .right .arm { left: -12px; transform: rotate(20deg); }

    @keyframes hugLeft {
      0% { transform: translateX(0) rotate(0deg); }
      100% { transform: translateX(25px) rotate(12deg); }
    }

    @keyframes hugRight {
      0% { transform: translateX(0) rotate(0deg); }
      100% { transform: translateX(-25px) rotate(-12deg); }
    }

    .sweet-msg {
      margin-top: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      color: #ff9ebb;
    }

    .letter-container::-webkit-scrollbar { width: 6px; }
    .letter-container::-webkit-scrollbar-thumb { background: #ff4b6e; border-radius: 10px; }
  </style>
</head>
<body>

  <!-- Matrix Background Canvas -->
