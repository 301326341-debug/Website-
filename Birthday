        <button class="quiz-btn" onclick="selectQuizAnswer('Infinite & Beyond!')">2️⃣ Infinite & Beyond! ♾️✨</button>
        <button class="quiz-btn" onclick="selectQuizAnswer('Poora Aasman Bhar Ke!')">3️⃣ Poora Aasman Bhar Ke! 🌌💕</button>
      </div>
      <div class="quiz-result" id="quizResult"></div>
    </div>

    <!-- STEP 4: INTERACTIVE KISS BUTTON -->
    <div class="kiss-section" id="kissSection">
      <button class="kiss-btn" onclick="triggerKissAnimation(event)">💋 Click Here For A Big Sweet Kiss! 💋</button>
      <div class="kiss-counter" id="kissCounter">Kisses Sent: 0 😘</div>
    </div>

    <!-- STEP 5: QUESTION FOR HER TO ANSWER "I LOVE YOU TOO" -->
    <div class="love-declaration" id="loveDeclaration">
      <div class="big-beating-heart">💖</div>
      <div class="ily-title">I LOVE YOU SO MUCH MERI CHOTI SI JANU JI! MERI MASHA ❤️</div>
      <p class="ily-question">Ab aapki bari! Aap kya kehna chahti ho? 🙈👇</p>
      
      <button class="reply-action-btn" id="replyBtn" onclick="submitILoveYouToo()">
        Click to say: "I love u too so much janu! 🥰✨"
